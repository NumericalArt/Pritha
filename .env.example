# Optional root override for scripts and tests.
TECHSCOPE_ROOT=

# Optional web UI settings.
HOST=127.0.0.1
PORT=3000

# Optional Telegram intake bot.
TECHSCOPE_TELEGRAM_BOT_TOKEN=
TECHSCOPE_TELEGRAM_ALLOWED_USER_IDS=
TECHSCOPE_TELEGRAM_OFFSET=0
TECHSCOPE_TELEGRAM_RETRY_INITIAL_MS=3000
TECHSCOPE_TELEGRAM_RETRY_MAX_MS=60000
TECHSCOPE_TELEGRAM_RETRY_JITTER_RATIO=0.25
TECHSCOPE_TELEGRAM_ERROR_LOG_INTERVAL_MS=60000

# Optional Realtime voice descendants. First-run setup leaves this disabled
# unless the user explicitly opts in and accepts cost/privacy trade-offs.
OPENAI_API_KEY=
TECHSCOPE_REALTIME_MODE=push-to-talk

# Optional Pritha Voice Control experiment.
TECHSCOPE_VOICE_HOST=127.0.0.1
TECHSCOPE_VOICE_PORT=3401
TECHSCOPE_VOICE_MODEL=gpt-realtime-2
TECHSCOPE_VOICE_REALTIME_VOICE=marin
TECHSCOPE_VOICE_TRANSCRIPTION_MODEL=gpt-4o-transcribe
TECHSCOPE_VOICE_CODEX_MODE=queue
TECHSCOPE_VOICE_CODEX_WRITE_ENABLED=0
TECHSCOPE_VOICE_PRIVATE_ROOT=

# Optional Pritha Control Center Realtime voice runtime.
# PRITHA_CONTROL_CENTER_ENV_FILE can point to a local ignored env file during experiments.
PRITHA_CONTROL_CENTER_ENV_FILE=
PRITHA_REALTIME_CODEX_MODE=exec
PRITHA_REALTIME_CODEX_WRITE_ENABLED=0
PRITHA_REALTIME_CODEX_TIMEOUT_MS=300000

# Optional local transcription helpers.
IMAGEIO_FFMPEG_BIN=
MLX_WHISPER_BIN=

# Local setup state is written to .techscope-setup.json. Do not commit it.
TECHSCOPE_SETUP_STATE=

# Optional stricter checks.
TECHSCOPE_ENV_DOCTOR_STRICT=0
TECHSCOPE_GOLDEN_EMBEDDINGS=0
PRITHA_SUPPRESS_DEPRECATION_NOTE=0

{
  "name": "pritha-control-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/host-policy.mjs && next dev --hostname 127.0.0.1 --port ${PRITHA_CONTROL_CENTER_PORT:-3420}",
    "build": "node scripts/build-preflight.mjs && next build",
    "serve": "npm run build && npm run start",
    "start": "node scripts/host-policy.mjs && next start --hostname 127.0.0.1 --port ${PRITHA_CONTROL_CENTER_PORT:-3420}",
    "test:e2e": "playwright test",
    "test:realtime-flow": "node --test tests/realtime-pictureboom-flow.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@audio/decode-mp3": "^1.1.0",
    "@types/qrcode": "1.5.6",
    "lucide-react": "1.17.0",
    "next": "16.2.11",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.184.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "nanoid": "3.3.18",
    "sharp": "0.35.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.184.1",
    "typescript": "6.0.3"
  }
}
